Modifications aux fichiers existants

1. Modifier routes.cpp pour ajouter les nouvelles routes :
cpp// Flavors
svr.Get("/api/flavors", [](req, res) { /* list flavors */ });

// Base images  
svr.Get("/api/images", [](req, res) { /* list images */ });

// Networks
svr.Get("/api/networks", [](req, res) { /* list networks */ });
svr.Post("/api/networks/user", [](req, res) { /* create user network */ });

// Swarm clusters
svr.Post("/api/swarm/clusters", [](req, res) { /* create cluster */ });
svr.Get("/api/swarm/clusters", [](req, res) { /* list clusters */ });
svr.Get("/api/swarm/clusters/:id", [](req, res) { /* get cluster */ });
svr.Delete("/api/swarm/clusters/:id", [](req, res) { /* delete cluster */ });

// Host strategy
svr.Put("/api/hosts/strategy", [](req, res) { /* set strategy */ });
3. Modifier vm_operations.cpp :

Remplacer la vérification de quota par la vérification de flavor
Utiliser BaseImageManager pour sélectionner l'image
Utiliser le réseau de l'utilisateur au lieu du réseau "default"

4. Mettre à jour main.cpp :
   
cpp// Initialize all managers
FlavorManager flavorMgr;
NetworkManager networkMgr(primaryConn);
RemoteExec::RemoteExecutor remoteExec(primaryConn);
BaseImageManager imageMgr(&remoteExec);

// Pass to operations
VMOperations vmOps(primaryConn, &hostManager, &imageMgr, &networkMgr);
SwarmOperations swarmOps(primaryConn, &vmOps, &networkMgr);

// Pass to routes
APIRoutes routes(&vmOps, &hostManager, &userOps, &paasOps, &swarmOps, 
                &flavorMgr, &imageMgr, &networkMgr, &logger);
