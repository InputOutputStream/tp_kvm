# /var/lib/thoth-cloud/.env

# Default hosts (comma-separated)
HOSTS=qemu+ssh://vps@192.168.122.237/system,qemu+ssh://vps@192.168.1.183/system
# SSH key for remote hosts
SSH_KEY_PATH=/home/user/.ssh

# Storage paths
IMAGES_PATH=/var/lib/libvirt/images
BASE_IMAGES_PATH=/var/lib/libvirt/images/baseimg
CLOUD_INIT_PATH=/var/lib/libvirt/images/cloud-init-iso

# Logging
LOG_LEVEL=INFO
LOG_PATH=/var/log/thoth-cloud

# Default quotas for new users
DEFAULT_MAX_VMS=1
DEFAULT_MAX_CPU=1
DEFAULT_MAX_RAM=1
DEFAULT_MAX_STORAGE=10

# Server settings
API_PORT=3000